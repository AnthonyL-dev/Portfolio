---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// Récupération des projets depuis la collection de contenu
const projets = await getCollection("projets");
---

<ul class="projects-list">
  {
    projets.map((projet) => (
      <li class="single-project">
        <div class="cd-title">
          <h2 aria-label={projet.data.titre}>
            {projet.data.titre}: {projet.data.description}
          </h2>
        </div>
        <div class="cd-project-info">
          <button class="cd-scroll">Faites défiler vers le bas</button>
          <div class="content-wrapper">
            <section class="bg-white py-16 px-6 md:px-12">
              <div class="max-w-6xl mx-auto space-y-24">
                {/* Bloc 1 : Introduction */}
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                  <div class="fade-in">
                    <h1
                      class="text-4xl font-bold text-gray-800 mb-6"
                      aria-label={projet.data.titre}
                    >
                      <span class="text-indigo-600">{projet.data.titre}</span> -
                      Introduction
                    </h1>
                    <p class="text-gray-600 text-lg mb-6">
                      {projet.data.description}, réalisé en{" "}
                      <span class="text-indigo-600 font-semibold">
                        {projet.data.langage}
                      </span>
                      , avec une architecture en{" "}
                      <strong>{projet.data.architecture}</strong>.
                    </p>
                    <p class="text-gray-600">{projet.data.but}</p>
                    <div class="mt-6">
                      {projet.data.technologies.map((tech) => (
                        <span class="inline-block bg-indigo-100 text-indigo-600 text-sm font-semibold px-3 py-1 rounded-full mr-2">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div class="fade-in flex justify-center">
                    <Image
                      width={50}
                      height={50}
                      src={projet.data.chemin_image_introduction}
                      alt={projet.data.alt_image_introduction}
                      class="rounded-lg shadow-xl w-full max-w-md transform transition-transform duration-500 hover:scale-105"
                    />
                  </div>
                </div>

                {/* Bloc 2 : Fonctionnalités */}
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center lg:flex-row-reverse">
                  <div class="fade-in">
                    <h2
                      class="text-4xl font-bold text-gray-800 mb-6"
                      aria-label="Fonctionnalités"
                    >
                      ✨ <span class="text-indigo-600">Fonctionnalités</span>
                    </h2>
                    <ul class="list-disc pl-6 text-gray-600 space-y-4">
                      {projet.data.fonctionnalites.map((fonctionnalite) => (
                        <li>{fonctionnalite}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="fade-in flex justify-center">
                    <Image
                      width={50}
                      height={50}
                      src={projet.data.chemin_image_fonctionnalites}
                      alt={projet.data.alt_image_fonctionnalites}
                      class="rounded-lg shadow-xl w-full max-w-md transform transition-transform duration-500 hover:scale-105"
                    />
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </li>
    ))
  }
</ul>
