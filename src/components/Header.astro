---
import { Image } from "astro:assets";
import type { iconPaths } from "./IconPaths";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "À Propos", href: "/" },
  { label: "Projet", href: "/projet/" },
  { label: "CV", href: "/cv/" },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  {
    label: "GitHub",
    href: "https://github.com/AnthonyL-dev",
    icon: "github-logo",
  },
  {
    label: "Email",
    href: "mailto:lorette.anthony.jrd@gmail.com",
    icon: "mail-icon",
  },
  {
    label: "Linkedin",
    href: "https://www.linkedin.com/in/anthony-lorette",
    icon: "linkedin-logo",
  },
];
---

<nav
  id="animated-nav"
  class="fixed top-0 left-0 right-0 z-[9999] w-full font-semibold bg-transparent py-6 lg:absolute"
>
  <div
    class="container mx-auto px-4 flex justify-between items-center min-w-[90vw]"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white no-underline">
      <Image
        src="/assets/logo/logo-blanc.svg"
        loading="eager"
        alt={"Logo AL"}
        width={50}
        height={50}
        class="transition-transform transform hover:scale-105"
      />
    </a>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex justify-end space-x-6">
      <!-- Text Links -->
      <div id="menu-content" class="flex space-x-6">
        {
          textLinks.map((link) => (
            <a href={link.href} class="text-white no-underline lg:text-lg ">
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Social Icon Links -->
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden text-white focus:outline-none"
      aria-label="Toggle mobile menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-black/90 z-[9998] flex flex-col justify-center items-center transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
  >
    <button
      id="mobile-menu-close"
      class="absolute top-6 right-6 text-white focus:outline-none"
      aria-label="Close mobile menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex flex-col space-y-6 text-center">
      {
        textLinks.map((link) => (
          <a
            href={link.href}
            class="text-white text-2xl hover:text-blue-300 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
    const mobileMenuClose = document.getElementById("mobile-menu-close");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuToggle.addEventListener("click", () => {
      mobileMenu.classList.remove("translate-x-full");
    });

    mobileMenuClose.addEventListener("click", () => {
      mobileMenu.classList.add("translate-x-full");
    });

    // Close mobile menu when a link is clicked
    const mobileMenuLinks = document.querySelectorAll("#mobile-menu a");
    mobileMenuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("translate-x-full");
      });
    });
  });
</script>

<style>
  #animated-nav {
    font-family: "Montserrat", sans-serif;
  }

  /* Hover effect for menu items */
  #menu-content a:hover {
    color: #93c5fd; /* Light blue for hover effect */
    text-decoration: underline;
  }
  /* Hover effect for icons */
  .hidden.lg\\:flex a:hover {
    color: #93c5fd; /* Light blue for hover effect on icons */
  }
</style>
