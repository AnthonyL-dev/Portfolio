<svg
  xmlns="http://www.w3.org/2000/svg"
  width="200"
  height="200"
  viewBox="0 0 200 200"
>
  <circle cx="100" cy="100" r="80" fill="none" stroke="black" stroke-width="5"
  ></circle>
</svg>

<style>
  svg circle {
    stroke-dasharray: 502; /* La longueur totale du contour du cercle (2 * π * r) */
    stroke-dashoffset: 502;
    animation: dessin 2s forwards;
  }

  @keyframes dessin {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
