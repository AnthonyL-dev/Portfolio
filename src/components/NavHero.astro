---
import { Image } from "astro:assets";
import Icon from "./svg/Icon.astro";
import type { iconPaths } from "./svg/IconPaths";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "À Propos", href: "/" },
  { label: "Projet", href: "/projet/" },
  { label: "Technologie", href: "/technologie/" },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  {
    label: "GitHub",
    href: "https://github.com/AnthonyL-dev",
    icon: "github-logo",
  },
  {
    label: "Email",
    href: "mailto:lorette.anthony.jrd@gmail.com",
    icon: "mail-icon",
  },
  {
    label: "Linkedin",
    href: "https://www.linkedin.com/in/anthony-lorette",
    icon: "linkedin-logo",
  },
];
---

<nav
  id="animated-nav"
  class="absolute top-6 left-0 right-0 z-[9999] w-screen font-brand font-medium mb-14 flex justify-center transition-all duration-700 ease-in-out opacity-0 -translate-y-full"
>
  <div class="flex flex-row bg-white rounded-lg justify-between min-w-[80vw]">
    <div class="flex justify-between gap-2 p-6 lg:p-0">
      <a
        href="/"
        class="flex items-center gap-2 text-gray-0 no-underline lg:text-lg"
      >
        <Image src="/assets/logo.svg" alt={"Logo AL"} width={50} height={50} />
      </a>
      <menu-button>
        <template>
          <button
            class="flex relative border-0 rounded-full p-2 text-2xl shadow-md lg:hidden"
            aria-expanded="false"
          >
            <span class="sr-only">Menu</span>
            <Icon icon="list" />
          </button>
        </template>
      </menu-button>
    </div>

    <noscript>
      <ul
        class="flex flex-col gap-4 text-base leading-5 list-none p-8 bg-gray-999 border-b border-gray-800 lg:flex-row lg:gap-0 lg:text-sm lg:rounded-full lg:border-0 lg:p-2 lg:bg-gradient-to-b from-gray-900 via-gray-800 to-transparent lg:shadow-md"
      >
        {
          textLinks.map(({ label, href }) => (
            <li>
              <a
                aria-current={Astro.url.pathname === href}
                class:list={[
                  "inline-block no-underline lg:px-4 lg:py-2 lg:rounded-full lg:transition-colors lg:hover:text-gray-100 lg:hover:bg-accent-subtle-overlay",
                  {
                    "text-gray-0 lg:text-accent-text-over lg:bg-accent-regular":
                      Astro.url.pathname === href ||
                      (href !== "/" && Astro.url.pathname.startsWith(href)),
                  },
                ]}
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </noscript>

    <noscript>
      <div
        class="flex justify-between gap-3 p-6 bg-gray-999 rounded-b-xl shadow-lg lg:justify-self-end lg:items-center lg:p-0 lg:bg-transparent lg:shadow-none"
      >
        <div class="flex flex-wrap gap-2.5 text-xl lg:hidden">
          {
            iconLinks.map(({ href, icon, label }) => (
              <a
                target="_blank"
                href={href}
                class="flex p-2 text-accent-dark no-underline transition-colors hover:text-accent-text-over focus:text-accent-text-over"
              >
                <span class="sr-only">{label}</span>
                <Icon icon={icon} />
              </a>
            ))
          }
        </div>
      </div>
    </noscript>

    <div
      id="menu-content"
      class="absolute left-0 right-0 lg:relative lg:flex lg:flex-row"
      hidden
    >
      <ul
        class="flex flex-col gap-4 text-base leading-5 list-none p-8 lg:flex-row lg:gap-0 lg:text-sm lg:rounded-full lg:border-0 lg:p-2"
      >
        {
          textLinks.map(({ label, href }) => (
            <li>
              <a
                aria-current={Astro.url.pathname === href}
                class:list={[
                  "inline-block  no-underline lg:px-4 lg:py-2 lg:rounded-full lg:transition-colors lg:hover:text-gray-100 lg:hover:bg-accent-subtle-overlay",
                  {
                    "text-gray-0 lg:text-accent-text-over lg:bg-accent-regular":
                      Astro.url.pathname === href ||
                      (href !== "/" && Astro.url.pathname.startsWith(href)),
                  },
                ]}
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="flex justify-between gap-3 p-6 rounded-b-xl lg:justify-self-end lg:items-center lg:p-0 lg:bg-transparent"
    >
      <div class="hidden lg:flex lg:justify-end lg:gap-0">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a
              target="_blank"
              href={href}
              class="flex p-2 text-accent-dark no-underline transition-colors hover:text-accent-text-over focus:text-accent-text-over"
            >
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;
      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;
      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };
      btn.addEventListener("click", () => setExpanded(menu.hidden));
      const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);

  window.addEventListener("DOMContentLoaded", () => {
    const nav = document.getElementById("animated-nav");

    if (nav) {
      // Vérifie que l'élément existe
      nav.classList.remove("opacity-0", "-translate-y-full"); // Enlève les classes d'état initial
      nav.classList.add("opacity-100", "translate-y-0"); // Ajoute les classes d'état final
    } else {
      console.error("L'élément avec l'ID 'animated-nav' est introuvable.");
    }
  });
</script>
