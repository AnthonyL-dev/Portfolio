---
import { Image } from "astro:assets";
import Icon from "./svg/Icon.astro";
import type { iconPaths } from "./svg/IconPaths";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "À Propos", href: "/" },
  { label: "Projet", href: "/projet/" },
  { label: "CV", href: "/cv/" },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  {
    label: "GitHub",
    href: "https://github.com/AnthonyL-dev",
    icon: "github-logo",
  },
  {
    label: "Email",
    href: "mailto:lorette.anthony.jrd@gmail.com",
    icon: "mail-icon",
  },
  {
    label: "Linkedin",
    href: "https://www.linkedin.com/in/anthony-lorette",
    icon: "linkedin-logo",
  },
];
---

<nav
  id="animated-nav"
  class="absolute top-6 left-0 right-0 z-[9999] w-screen font-semibold mb-14 flex justify-center"
>
  <div class="flex flex-row justify-between min-w-[90vw]">
    <div class="flex justify-between gap-2 p-6 lg:p-0">
      <a
        href="/"
        class="flex items-center gap-2 text-white no-underline lg:text-lg"
      >
        <Image
          src="/assets/logo-blanc.svg"
          loading="eager"
          alt={"Logo AL"}
          width={50}
          height={50}
          class="transition-transform transform hover:scale-105"
        />
      </a>
      <menu-button>
        <template>
          <button
            class="flex relative border-0 rounded-full p-2 text-2xl shadow-md lg:hidden"
            aria-expanded="false"
          >
            <span class="sr-only">Menu</span>
            <Icon icon="list" />
          </button>
        </template>
      </menu-button>
    </div>

    <div
      id="menu-content"
      class="absolute left-0 right-0 lg:relative lg:flex lg:flex-row"
      hidden
    >
      <ul
        class="flex flex-col gap-4 text-base leading-5 list-none p-8 lg:flex-row lg:gap-0 lg:text-lg lg:rounded-full lg:border-0 lg:p-2 lg:font-medium"
      >
        {
          textLinks.map(({ label, href }) => (
            <li>
              <a
                aria-current={Astro.url.pathname === href}
                class:list={[
                  "inline-block no-underline lg:px-4 lg:py-2 lg:rounded-full lg:transition-colors lg:duration-300 lg:hover:text-gray-100 lg:hover:bg-accent-subtle-overlay text-white",
                  {
                    "text-white lg:text-accent-text-over lg:bg-accent-regular":
                      Astro.url.pathname === href ||
                      (href !== "/" && Astro.url.pathname.startsWith(href)),
                  },
                ]}
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- <div
      class="flex justify-between gap-3 p-6 rounded-b-xl lg:justify-self-end lg:items-center lg:p-0 lg:bg-transparent"
    >
      <div class="hidden lg:flex lg:justify-end lg:gap-0">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a
              target="_blank"
              href={href}
              class="flex p-2 text-white no-underline transition-colors hover:text-blue-300 focus:text-blue-300"
            >
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>
    </div> -->
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;
      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;
      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };
      btn.addEventListener("click", () => setExpanded(menu.hidden));
      const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  /* Custom Tailwind styles */
  #animated-nav {
    font-family: "Montserrat", sans-serif;
  }

  /* Hover effect for menu items */
  #menu-content a:hover {
    color: #93c5fd; /* Light blue for hover effect */
    text-decoration: underline;
  }

  /* Hover effect for icons */
  .hidden.lg\\:flex a:hover {
    color: #93c5fd; /* Light blue for hover effect on icons */
  }
</style>

