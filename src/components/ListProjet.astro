---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
---
interface Project {
    id: number;
    title: string;
    description: string;
    technologies: string[];
    imageUrl: string;
    githubUrl: string;
    liveUrl?: string;
    featured: boolean;
}

const projects: Project[] = [
    {
        id: 1,
        title: "E-commerce App",
        description: "Une application full-stack avec panier d'achat, authentification et paiement Stripe.",
        technologies: ["React", "Node.js", "MongoDB", "Stripe"],
        imageUrl: "/projects/ecommerce.jpg",
        githubUrl: "https://github.com/username/ecommerce",
        liveUrl: "https://ecommerce-demo.com",
        featured: true
    },
    {
        id: 2,
        title: "Dashboard Analytics",
        description: "Tableau de bord interactif avec visualisation de données en temps réel.",
        technologies: ["Vue.js", "D3.js", "Firebase"],
        imageUrl: "/projects/dashboard.jpg",
        githubUrl: "https://github.com/username/dashboard",
        featured: true
    },
    // Ajoutez d'autres projets ici
];
---

<Layout title="Mes Projets | Portfolio">
    <main class="min-h-screen bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            {/* En-tête */}
            <div class="text-center mb-16">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">
                    Mes Projets
                </h1>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    Découvrez une sélection de mes projets les plus récents, 
                    démontrant mes compétences en développement web et mobile.
                </p>
            </div>

            {/* Filtres */}
            <div class="flex flex-wrap gap-4 justify-center mb-12">
                <button class="px-6 py-2 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition">
                    Tous
                </button>
                <button class="px-6 py-2 bg-gray-200 text-gray-700 rounded-full hover:bg-gray-300 transition">
                    Web
                </button>
                <button class="px-6 py-2 bg-gray-200 text-gray-700 rounded-full hover:bg-gray-300 transition">
                    Mobile
                </button>
                <button class="px-6 py-2 bg-gray-200 text-gray-700 rounded-full hover:bg-gray-300 transition">
                    UI/UX
                </button>
            </div>

            {/* Grille des projets */}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {projects.map((project) => (
                    <article key={project.id} class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition duration-300">
                        <div class="relative">
                            <img 
                                src={project.imageUrl} 
                                alt={project.title}
                                class="w-full h-48 object-cover"
                            />
                            {project.featured && (
                                <span class="absolute top-4 right-4 bg-indigo-600 text-white px-3 py-1 rounded-full text-sm">
                                    Featured
                                </span>
                            )}
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">
                                {project.title}
                            </h3>
                            <p class="text-gray-600 mb-4">
                                {project.description}
                            </p>
                            <div class="flex flex-wrap gap-2 mb-4">
                                {project.technologies.map((tech) => (
                                    <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                            <div class="flex gap-4">
                                <a 
                                    href={project.githubUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex-1 text-center py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition"
                                >
                                    GitHub
                                </a>
                                {project.liveUrl && (
                                    <a 
                                        href={project.liveUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex-1 text-center py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"
                                    >
                                        Demo Live
                                    </a>
                                )}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </main>
</Layout>

<style>
    /* Ajoutez des styles personnalisés si nécessaire */
</style>