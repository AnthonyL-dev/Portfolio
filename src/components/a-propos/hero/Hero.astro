---
import { Image } from "astro:assets";
import Icon from "../../Icon.astro";
import type { iconPaths } from "../../IconPaths";
import InfiniteMarquee from "./InfiniteMarquee.astro";
import Localisation from "./Localisation.astro";

const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  {
    label: "Email",
    href: "mailto:lorette.anthony.jrd@gmail.com",
    icon: "mail-icon",
  },
  {
    label: "Linkedin",
    href: "https://www.linkedin.com/in/anthony-lorette",
    icon: "linkedin-logo",
  },
  {
    label: "GitHub",
    href: "https://github.com/AnthonyL-dev",
    icon: "github-logo",
  },
];
---

<div class="absolute inset-0 flex justify-center items-end z-1">
  <Image
    src="/assets/a-propos/hero/portrait.png"
    loading="eager"
    width={657}
    height={950}
    alt="Portrait professionnel"
    class="w-full h-screen lg:max-w-[35vw] max-h-[95vh] object-cover"
  />
</div>
<div class="h-screen w-screen">
  <div class="bg-[#0040c1] relative h-screen overflow-hidden font-montserrat">
    <div
      class="font-bold text-white absolute z-3 top-[45%] left-[5%] text-xl flex flex-col md:top-[40%] md:left-[70%] md:text-4xl"
    >
      Développeur logiciel<br />web & mobile

      <div class="py-5 flex justify-start gap-0 my-3 lg:my-auto">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a
              target="_blank"
              href={href}
              class="flex pr-4 text-white no-underline transition-colors hover:text-blue-300 focus:text-blue-300"
            >
              <span class="sr-only">{label}</span>
              <Icon icon={icon} class="w-4 h-4" />
            </a>
          ))
        }
      </div>

      <a
        href="#about"
        id="scrollButton"
        class="group relative inline-flex items-center gap-2 text-white font-semibold text-lg hover:text-gray-200 transition"
      >
        <span class="relative inline-block">
          Voir la suite
          <span
            class="transform transition-transform duration-300 group-hover:translate-x-2"
            >→</span
          >
          <span
            class="absolute left-0 bottom-0 w-0 h-[2px] bg-white transition-all duration-300 group-hover:w-full"
          ></span>
        </span>
      </a>
    </div>
    <div class="absolute top-[40%] text-4xl z-1">
      <Localisation />
    </div>
    <div class="text-white absolute top-[70%] z-2"><InfiniteMarquee /></div>
  </div>
  <div class="cube hidden md:block"></div>
  <div class="cube hidden md:block"></div>
  <div class="cube hidden md:block"></div>
  <div class="cube hidden md:block"></div>
  <div class="cube hidden md:block"></div>
  <div class="cube hidden md:block"></div>
</div>

<style>
  /* bas droite */
  .cube {
    position: absolute;
    top: 75vh;
    left: 75vw;
    width: 10px;
    height: 10px;
    border: solid 1px #0035a5;
    transform-origin: top left;
    transform: scale(0) rotate(0deg) translate(-50%, -50%);
    animation: cube 8s ease-in forwards infinite;
  }

  .cube:nth-child(2n) {
    border-color: #0050f5;
  }

  .cube:nth-child(3) {
    animation-delay: 1s; /* haut gauche */
    left: 15vw;
    top: 20vh;
  }
  .cube:nth-child(4) {
    animation-delay: 2s; /* haut droite */
    left: 75vw;
    top: 15vh;
  }
  .cube:nth-child(7) {
    animation-delay: 3s; /* milieu droite */
    left: 90vw;
    top: 50vh;
  }
  .cube:nth-child(5) {
    animation-delay: 4s; /* bas gauche */
    left: 15vw;
    top: 75vh;
  }
  .cube:nth-child(6) {
    animation-delay: 5s; /* milieu gauche */
    left: 25vw;
    top: 45vh;
  }

  @keyframes cube {
    from {
      transform: scale(0) rotate(0deg) translate(-50%, -50%);
      opacity: 1;
    }
    to {
      transform: scale(20) rotate(960deg) translate(-50%, -50%);
      opacity: 0;
    }
  }
</style>
