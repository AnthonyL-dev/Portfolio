---
import { Image } from "astro:assets";
interface Props {
  image: string;
  alt: string;
  description: string;
}
const { image, alt, description } = Astro.props;
---

<div
  class="group relative w-11/12 max-w-md min-h-[36rem] rounded-lg overflow-hidden cursor-pointer mx-auto my-4 sm:w-[calc(50%-1rem)] md:w-[calc(33.333%-1rem)]"
>
  <Image
    src={image}
    alt={alt}
    width={384}
    height={576}
    class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-200"
  />
  <div class="absolute inset-0 flex flex-col justify-end p-7 text-white">
    <h2
      class="absolute bottom-[30px] left-[30px] text-white bg-black/25 backdrop-blur-sm px-2 py-1
      transition-all duration-300 group-hover:opacity-0 group-hover:translate-y-[-20px]"
    >
      {alt}
    </h2>
    <p
      class="absolute bottom-[30px] left-[30px] mt-12 text-white bg-black/25 backdrop-blur-sm px-2 py-1 opacity-0 max-w-[80%]
      group-hover:opacity-100 group-hover:translate-y-[-20px] transition-all duration-500"
    >
      {description}
    </p>
  </div>
</div>
