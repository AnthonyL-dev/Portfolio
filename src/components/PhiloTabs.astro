---
interface Tab {
  id: string;
  title: string;
  content: string;
  imageSrc: string;
  ctaUrl: string;
  ctaText: string;
}

const tabs: Tab[] = [
  {
    id: "tab1",
    title: "Tab 1",
    content: "Content for Tab 1",
    imageSrc: "/assets/langages/hono-original.svg",
    ctaUrl: "#",
    ctaText: "Learn More",
  },
  {
    id: "tab2",
    title: "Tab 2",
    content: "Content for Tab 2",
    imageSrc: "/assets/images/tab2-image.svg",
    ctaUrl: "#",
    ctaText: "Learn More",
  },
  // Add more tabs as needed
];
---

<div class="container mx-auto p-4">
  <h2 class="text-center text-2xl font-bold mb-4">Vertical Tabs</h2>
  <div class="flex">
    <!-- Tabs Sidebar -->
    <div class="w-1/4">
      {
        tabs.map((tab) => (
          <button
            id={`button-${tab.id}`}
            class="tab-button py-2 px-4 w-full text-left border-l-4 border-transparent hover:border-blue-500 hover:bg-gray-100 focus:outline-none focus:border-blue-500"
            data-target={tab.id}
          >
            {tab.title}
          </button>
        ))
      }
    </div>
    <!-- Tab Content -->
    <div class="w-3/4 p-4">
      {
        tabs.map((tab) => (
          <div id={tab.id} class="tab-content hidden">
            <h3 class="text-xl font-semibold mb-2">{tab.title}</h3>
            <img
              src={tab.imageSrc}
              alt={`Image for ${tab.title}`}
              class="w-full max-h-64 object-contain mb-4"
            />
            <p>{tab.content}</p>
            <a
              href={tab.ctaUrl}
              class="mt-4 inline-block bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600"
            >
              {tab.ctaText}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-button");
  const contents = document.querySelectorAll<HTMLDivElement>(".tab-content");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      // Hide all contents
      contents.forEach((content) => content.classList.add("hidden"));
      // Remove active state from all buttons
      buttons.forEach((btn) =>
        btn.classList.remove("border-blue-500", "bg-gray-100")
      );
      // Show target content
      const targetId = button.getAttribute("data-target");
      if (targetId) {
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.remove("hidden");
        }
      }
      // Add active state to clicked button
      button.classList.add("border-blue-500", "bg-gray-100");
    });
  });

  // Set initial active tab
  if (buttons.length > 0) {
    buttons[0].click(); // `click()` is now recognized because of type casting
  }
</script>
