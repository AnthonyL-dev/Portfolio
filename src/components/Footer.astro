---
import Icon from "./Icon.astro";
---

<footer class="p-4 md:p-6 lg:p-8 bg-gray-800 w-screen">
  <div class="mx-auto flex flex-wrap justify-between items-center">
    <!-- Section gauche : Copyright -->
    <div class="flex-1 text-left text-sm text-gray-500 dark:text-gray-400">
      © 2024-2025 Anthony Lorette™
    </div>

    <!-- Section centrale : Options de navigation -->
    <div class="flex-1 text-center">
      <ul
        class="flex flex-wrap justify-center items-center space-x-4 md:space-x-6 text-gray-900 dark:text-white"
      >
        <li>
          <a href="/" class="hover:underline">À propos</a>
        </li>
        <li>
          <a href="/contact" class="hover:underline">Projets</a>
        </li>
        <li>
          <a href="/cv" target="_blank" class="hover:underline">CV</a>
        </li>
      </ul>
    </div>

    <!-- Section droite : Moyens de contact -->

    <div class="flex flex-1 justify-end space-x-4">
      <a
        href="mailto:lorette.anthony.jrd@gmail.com"
        class="text-gray-500 hover:text-gray-900 dark:hover:text-white"
        aria-label="Envoyer un email"
      >
        <Icon icon="mail-icon" />
      </a>
      <a
        href="https://linkedin.com/in/anthony"
        target="_blank"
        class="text-gray-500 hover:text-gray-900 dark:hover:text-white"
        aria-label="Visiter mon linkedin"
      >
        <Icon icon="linkedin-logo" />
      </a>
      <a
        href="https://github.com/AnthonyL-dev"
        target="_blank"
        class="text-gray-500 hover:text-gray-900 dark:hover:text-white"
        aria-label="Visiter mon github"
      >
        <Icon icon="github-logo" />
      </a>
    </div>
  </div>
</footer>
