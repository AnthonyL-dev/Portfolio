<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Doto:wght@100..900&display=swap"
  rel="stylesheet"
/>

<section class="hero">
  <div class="conteneur">
    <div class="marquee">
      <ul>
        <li><span class="text">Anthony Lorette</span></li>
      </ul>
      <ul aria-hidden="true">
        <li>
          <span class="text">Anthony Lorette</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  :root {
    --gap: 15rem;
    --primary-color: #212121; /* Gris foncé pour les textes principaux */
    --secondary-color: #a2a2a2; /* Gris clair pour le fond et les accents */
    --accent-color: #5a6c9b; /* Indigo doux pour ajouter un contraste subtil */
    --bg-dark: #f7f7f7; /* Gris très clair pour le fond général */
  }

  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(
      135deg,
      var(--secondary-color),
      var(--accent-color)
    );
    animation: waveAnimation 12s ease-in-out infinite;
    background-size: 400% 400%;
  }

  .conteneur {
    width: 100%;
    height: 100%;
  }

  .marquee {
    overflow: hidden;
    user-select: none;
    display: flex;
    gap: var(--gap);
    transform: rotate(-4deg);
    font-family: "Bebas Neue", serif;
  }

  ul {
    list-style: none;
    flex-shrink: 0;
    min-width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap);
    animation: marquee 8s linear infinite;
  }

  .text {
    color: #000000; /* Texte en noir */
    font-weight: 400;
    font-size: 50ch;
  }

  @keyframes waveAnimation {
    0% {
      background-position: 0% 50%;
    }
    25% {
      background-position: 50% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    75% {
      background-position: 50% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-100% - var(--gap)));
    }
  }
</style>
