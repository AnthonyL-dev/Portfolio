---
import { Image } from "astro:assets";
import MainHead from "../components/MainHead.astro";
---

<head>
  <MainHead title="test" description="test" />
</head>
<body>
  <header>
    <a href="/" class="cd-logo"
      ><Image
        alt="logo"
        src="/assets/logo-blanc.svg"
        width="50"
        height="50"
      /></a
    >

    <button class="cd-nav-trigger"
      >Menu<span aria-hidden="true" class="cd-icon"></span></button
    >
  </header>

  <nav class="cd-primary-nav">
    <ul>
      <li class="cd-label">Navigation</li>
      <li><a href="/">À Propos</a></li>
      <li><a href="/projet/">Projet</a></li>
      <li><a href="/technologie/">Technologie</a></li>
    </ul>
  </nav>
  <!-- .cd-primary-nav -->

  <div class="cd-projects-container">
    <ul>
      <li class="single-project">
        <div class="cd-title">
          <h2>Windev</h2>
        </div>
        <!-- .cd-title -->

        <div class="cd-project-info">
          <button class="cd-scroll">Scroll down</button>

          <div class="content-wrapper">
            <section class="bg-white py-16 px-6 md:px-12">
              <div class="max-w-6xl mx-auto space-y-16">
                <!-- Première section : Texte à gauche, Image à droite -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                  <!-- Texte -->
                  <div>
                    <h1 class="text-4xl font-bold text-gray-800 mb-6">
                      Windev - Introduction
                    </h1>
                    <p class="text-gray-600 text-lg mb-8">
                      Projet de démonstration et d'expérimentation sous le
                      langage Windev, réalisé en <strong>Windev Express</strong>
                      avec une architecture en <strong
                        >Programmation Orientée Objet (POO)</strong
                      >.
                    </p>
                    <p class="text-gray-600">
                      Ce projet explore les capacités de Windev pour des
                      solutions d'entreprise, telles que l'inscription, la
                      gestion des utilisateurs, les réservations et la gestion
                      des employés.
                    </p>
                  </div>
                  <!-- Image -->
                  <div class="flex justify-center">
                    <img
                      src="/assets/WindevLogin.png"
                      alt="Prévisualisation du projet Windev"
                      class="rounded-lg shadow-lg w-full max-w-md"
                    />
                  </div>
                </div>

                <!-- Deuxième section : Image à gauche, Texte à droite -->
                <div
                  class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center lg:flex-row-reverse"
                >
                  <!-- Image -->
                  <div class="flex justify-center">
                    <img
                      src="/assets/WindevDashboard.png"
                      alt="Deuxième prévisualisation du projet Windev"
                      class="rounded-lg shadow-lg w-full max-w-md"
                    />
                  </div>
                  <!-- Texte -->
                  <div>
                    <h2 class="text-4xl font-bold text-gray-800 mb-6">
                      ✨ Fonctionnalités
                    </h2>
                    <ul class="list-disc pl-6 text-gray-600 space-y-2">
                      <li>Mise à jour automatique</li>
                      <li>Inscription externe</li>
                      <li>Accès Visiteurs</li>
                      <li>Espace Collaborateurs</li>
                      <li>Vérification de compte</li>
                      <li>Oubli de mot de passe</li>
                      <li>Emails transactionnels</li>
                      <li>Authentification et OAuth</li>
                      <li>Profil utilisateur</li>
                      <li>Alertes et actualités</li>
                      <li>Gestion des employés</li>
                      <li>Réservation événementielle</li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
        <!-- .cd-project-info -->
      </li>

      <li class="single-project">
        <div class="cd-title">
